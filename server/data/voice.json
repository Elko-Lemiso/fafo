    { "id": "start-5", "ev": "start", "t": "No pressure. Well, a little bit of pressure." },
    { "id": "start-6", "ev": "start", "t": "Let the games begin." },

    { "id": "intro-photo-1", "ev": "intro-photo", "t": "Whose photo is this? Think hard." },
