{
  "about": "The host's lines. ev says when a line can play; t is what's said and shown as the caption. Record them with tools/make-voice.js. Changing a line's text makes the script record it again.",
  "lines": [
    { "id": "welcome-1", "ev": "welcome", "t": "Welcome to fafo. Phones out, scan the code, let's get going." },
    { "id": "welcome-2", "ev": "welcome", "t": "Evening, everyone. Scan the code on the screen to join." },
    { "id": "welcome-3", "ev": "welcome", "t": "Right, who's playing? Scan the code and pick a name." },
    { "id": "welcome-4", "ev": "welcome", "t": "Welcome to fafo, where you find out who your friends really are." },

    { "id": "join-1", "ev": "join", "t": "Ooh, a new challenger." },
    { "id": "join-2", "ev": "join", "t": "Look who finally showed up." },
    { "id": "join-3", "ev": "join", "t": "Another one. Lovely." },
    { "id": "join-4", "ev": "join", "t": "Welcome aboard." },
    { "id": "join-5", "ev": "join", "t": "They're in. No backing out now." },
