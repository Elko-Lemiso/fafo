    { "id": "intro-photo-3", "ev": "intro-photo", "t": "Someone in this room took this one." },
    { "id": "intro-photo-4", "ev": "intro-photo", "t": "Look closely. Whose is it?" },
    { "id": "intro-photo-5", "ev": "intro-photo", "t": "Somebody's camera roll is about to be exposed." },
    { "id": "intro-photo-6", "ev": "intro-photo", "t": "Next photo. Keep a straight face, whoever you are." },

    { "id": "intro-song-1", "ev": "intro-song", "t": "Whose song is this? Somebody picked it." },
    { "id": "intro-song-2", "ev": "intro-song", "t": "Listen up. Which one of you chose this?" },
    { "id": "intro-song-3", "ev": "intro-song", "t": "This one says a lot about someone." },
    { "id": "intro-song-4", "ev": "intro-song", "t": "Whose taste in music are we judging now?" },
    { "id": "intro-song-5", "ev": "intro-song", "t": "Somebody's favourite song. Whose?" },

    { "id": "intro-prof-1", "ev": "intro-prof", "t": "Whose answer is this?" },
    { "id": "intro-prof-2", "ev": "intro-prof", "t": "One of you picked this. Who?" },
    { "id": "intro-prof-3", "ev": "intro-prof", "t": "Who said that? Think about it." },
    { "id": "intro-prof-4", "ev": "intro-prof", "t": "How well do you really know each other?" },

